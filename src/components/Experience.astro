---
import { getCollection, render } from 'astro:content';
import { ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].experience;
const entries = (await getCollection('experience', (e) => e.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const rows = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---

<section id="past-experience" class="section" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="experience-title">{t.title}</h2>
      <p>{t.intro}</p>
    </div>

    <div class="sheet">
      <div class="sheet-head data" aria-hidden="true">
        <span>noRoof development</span>
        <span>{t.origin}</span>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col" class="data">{t.cols.item}</th>
              <th scope="col" class="data">{t.cols.industry}</th>
              <th scope="col" class="data">{t.cols.work}</th>
              <th scope="col" class="data">{t.cols.stack}</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map(({ e, Content }) => (
                <tr>
                  <td class="data item">{String(e.data.order).padStart(3, '0')}</td>
                  <th scope="row" class="industry">{e.data.industry}</th>
                  <td class="work"><Content /></td>
                  <td class:list={['stack', 'data', { 'is-empty': !e.data.stack.length }]}>{e.data.stack.length ? e.data.stack.join(' · ') : '—'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .sheet {
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 0 1rem 2rem -1.5rem rgb(27 33 31 / 0.45);
  }
  .sheet-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding: 0.75rem clamp(1rem, 2vw, 1.5rem);
    border-bottom: 2px solid var(--ink);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  .table-scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
  }
  thead th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--paper-ink-soft);
    padding: 0.75rem clamp(0.75rem, 1.5vw, 1.5rem);
    border-bottom: 2px solid var(--ink);
  }
  tbody tr + tr > * {
    border-top: 1px dashed var(--rule);
  }
  td,
  tbody th {
    vertical-align: top;
    text-align: left;
    padding: 1.125rem clamp(0.75rem, 1.5vw, 1.5rem);
  }
  .item {
    width: 4.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--paper-ink-soft);
  }
  .industry {
    width: 16rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }
  .work :global(p) {
    font-size: 1rem;
    line-height: 1.55;
    max-width: 58ch;
  }
  .stack {
    width: 18rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--paper-ink-soft);
  }
  tbody tr {
    transition: background-color 160ms var(--ease-out);
  }
  tbody tr:hover {
    background: #eeeee8;
  }

  /* phones: each manifest line becomes a stacked entry */
  @media (max-width: 48rem) {
    table,
    tbody,
    tr,
    td,
    tbody th {
      display: block;
      width: auto;
    }
    table {
      min-width: 0;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tbody tr {
      display: grid;
      grid-template-columns: 3rem 1fr;
      padding: 1.25rem 1rem;
      gap: 0.5rem 0.75rem;
    }
    tbody tr + tr {
      border-top: 1px dashed var(--rule);
    }
    tbody tr + tr > * {
      border-top: 0;
    }
    td,
    tbody th {
      padding: 0;
    }
    .item {
      padding-top: 0.3rem;
    }
    .item,
    .industry,
    .work,
    .stack {
      width: auto;
      min-width: 0;
    }
    .work,
    .stack {
      grid-column: 2;
    }
    .stack.is-empty {
      display: none;
    }
  }
</style>
