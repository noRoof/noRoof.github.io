---
import { ui, type Locale } from '../lib/i18n';
import { containerCode } from '../lib/iso6346';
import Arrow from './Arrow.astro';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale].hero;
const code = containerCode('NRD', '000001');
const status = ui[locale].projects.status;
const products = (await getCollection('products', (p) => p.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid wrap">
    <div class="box">
      <span class="casting tl" aria-hidden="true"></span>
      <span class="casting tr" aria-hidden="true"></span>
      <span class="casting bl" aria-hidden="true"></span>
      <span class="casting br" aria-hidden="true"></span>
      <p class="code data" aria-hidden="true">{code}<br />45G1 · MVD</p>
      <h1 id="hero-title">
        {t.title.map((line, i) => <span class:list={['line', { last: i === t.title.length - 1 }]}>{line}</span>)}
      </h1>
    </div>

    <aside class="bill" aria-label={t.billTitle}>
      <p class="bill-title data">{t.billTitle}</p>
      <p class="lead">{t.lead}</p>
      <dl class="rows">
        <div><dt class="data">{t.rows.from[0]}</dt><dd>{t.rows.from[1]}</dd></div>
        <div>
          <dt class="data">{t.rows.to[0]}</dt>
          <dd class="consignee"><s>{t.rows.toStruck}</s> {t.rows.to[1]}</dd>
        </div>
        <div><dt class="data">{t.rows.method[0]}</dt><dd>{t.rows.method[1]}</dd></div>
        <div><dt class="data">{t.rows.cargo[0]}</dt><dd>{t.rows.cargo[1]}</dd></div>
      </dl>
      <div class="bill-actions">
        <a class="seal" href="#contact">{t.primary}<Arrow /></a>
        <a class="secondary" href="#projects">{t.secondary}<Arrow dir="down" /></a>
      </div>
    </aside>
  </div>
  <div class="quay" aria-hidden="true"></div>
  <nav class="strip wrap" aria-label={t.strip}>
    {
      products.map((p) => {
        const slug = p.id.split('/')[1];
        return (
          <a class:list={['mini', `is-${p.data.status}`]} href={`#product-${slug}`} data-open-unit={`product-${slug}`}>
            <span class="mini-name">{p.data.name}</span>
            <span class="mini-meta data">
              <span>{containerCode(p.data.owner, p.data.serial)}</span>
              <span>{status[p.data.status]}</span>
            </span>
          </a>
        );
      })
    }
  </nav>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 23rem);
    gap: clamp(1rem, 1.6vw, 1.5rem);
    align-items: stretch;
  }

  /* 40-ft container, side elevation */
  .box {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(22rem, 52vh, 30rem);
    padding: clamp(4.5rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3.5rem) clamp(1.75rem, 3.5vw, 2.75rem);
    background: var(--corrugation);
    border-block: 0.875rem solid var(--box-dark);
    border-inline: 0.625rem solid var(--box-dark);
    color: var(--box-ink);
    box-shadow: 0 1.25rem 2.5rem -1.5rem rgb(27 33 31 / 0.55);
  }
  .casting {
    position: absolute;
    width: 1.5rem;
    height: 1.25rem;
    background: var(--ink-2);
  }
  .casting::after {
    content: '';
    position: absolute;
    inset: 0.375rem 0.5rem;
    background: var(--ink);
    border-radius: 0.25rem;
  }
  .tl { top: -0.875rem; left: -0.625rem; }
  .tr { top: -0.875rem; right: -0.625rem; }
  .bl { bottom: -0.875rem; left: -0.625rem; }
  .br { bottom: -0.875rem; right: -0.625rem; }

  .code {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    font-size: clamp(0.875rem, 1.3vw, 1.125rem);
    font-weight: 700;
    line-height: 1.35;
    text-align: right;
  }
  h1 {
    font-size: clamp(3.25rem, 7.4vw, 6rem);
    font-weight: 900;
    line-height: 0.88;
  }
  h1 .line {
    display: block;
  }
  h1 .last {
    margin-top: 0.18em;
    font-size: 0.62em;
    letter-spacing: 0.02em;
  }

  /* bill of lading on the door end */
  .bill {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    background: var(--paper);
    border: 2px solid var(--ink);
  }
  .bill-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: 0.625rem;
    border-bottom: 2px solid var(--ink);
  }
  .lead {
    font-size: 1.1875rem;
    line-height: 1.35;
    font-weight: 600;
    font-stretch: 96%;
  }
  .rows {
    margin: 0;
    display: grid;
  }
  .rows div {
    display: grid;
    grid-template-columns: 6.75rem 1fr;
    gap: 0.75rem;
    padding-block: 0.4rem;
    border-bottom: 1px dashed var(--rule);
  }
  .rows dt {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--paper-ink-soft);
    padding-top: 0.2rem;
  }
  .rows dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .consignee {
    font-size: 1.0625rem !important;
  }
  .rows s {
    color: var(--paper-ink-soft);
    font-weight: 400;
    text-decoration-thickness: 2px;
  }
  .bill-actions {
    margin-top: auto;
    display: grid;
    gap: 0.75rem;
  }
  .bill-actions .seal {
    width: 100%;
    font-size: 1.25rem;
    min-height: 3.5rem;
  }
  .secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    font-weight: 700;
    min-height: 2.75rem;
  }

  .quay {
    height: 3px;
    background: var(--ink);
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
  }

  /* the stack, seen from the quay: one container per product */
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    padding-top: clamp(0.75rem, 1.6vw, 1.25rem);
  }
  .mini {
    --paint: var(--corrugation);
    --frame: var(--box-dark);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    min-height: 5.5rem;
    padding: 0.75rem 1rem;
    background: var(--paint);
    border: 0.375rem solid var(--frame);
    color: var(--paper);
    text-decoration: none;
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .mini:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.75rem 1.25rem -0.75rem rgb(27 33 31 / 0.6);
  }
  .mini.is-development {
    --frame: #232826;
    --paint: repeating-linear-gradient(90deg, #343b38 0 1.375rem, #272d2a 1.375rem 1.875rem, #3a413e 1.875rem 2.75rem);
  }
  .mini.is-paused {
    --frame: #9d9a91;
    --paint: repeating-linear-gradient(90deg, #b8b5ab 0 1.375rem, #a9a69c 1.375rem 1.875rem, #bfbcb3 1.875rem 2.75rem);
    color: var(--ink);
  }
  .mini-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 2.6vw, 2.375rem);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .mini-meta {
    display: grid;
    justify-items: end;
    gap: 0.125rem;
    padding: 0.3rem 0.5rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .strip {
      grid-template-columns: 1fr;
    }
    .mini {
      min-height: 4.25rem;
    }
    .box {
      min-height: 0;
      padding-top: 5.5rem;
    }
  }
</style>
