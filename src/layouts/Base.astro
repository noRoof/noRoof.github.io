---
import '../styles/global.css';
import { ui, homePath, type Locale } from '../lib/i18n';
import Rail from '../components/Rail.astro';
import Footer from '../components/Footer.astro';
import ogImage from '../assets/brand/fulllogo.png';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of this page in the other locale, for the ES/EN plates and hreflang. */
  alternate?: string;
  noindex?: boolean;
}

const { locale, title, description, alternate, noindex = false } = Astro.props;
const t = ui[locale];
const pageTitle = title ?? t.title;
const pageDescription = description ?? t.description;
const site = Astro.site ?? new URL('https://noroof.dev');
const canonical = new URL(Astro.url.pathname, site);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const otherPath = alternate ?? homePath(otherLocale);
const esPath = locale === 'es' ? Astro.url.pathname : otherPath;
const enPath = locale === 'en' ? Astro.url.pathname : otherPath;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1b211f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="noRoof development" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_UY' : 'en_US'} />
    <meta property="og:image" content={new URL(ogImage.src, site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@noroofdev" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-77XRTM625R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-77XRTM625R');
    </script>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Rail locale={locale} otherPath={otherPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
